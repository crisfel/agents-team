{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "arquitecto",

  // Las reglas se evalúan en orden y prevalece la última coincidencia.
  // Las excepciones específicas de cada agente se cargan después de esta lista.
  "instructions": [
    "seguridad/politica-global.md",
    "seguridad/comandos/*.md",
    "seguridad/bases-de-datos/politica-global.md",
    "seguridad/bases-de-datos/validacion-entorno.md",
    "seguridad/bases-de-datos/motores/*.md",
    "seguridad/lenguajes/*.md",
    "seguridad/frameworks/*.md",
    "seguridad/mecanismos/*.md"
  ],

  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "**/*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "**/*.pfx", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/*.env", "effect": "deny" },
    { "action": "read", "resource": "**/*.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": "**/*.env.example", "effect": "allow" },
    { "action": "read", "resource": "id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "glob", "resource": "*", "effect": "allow" },

    { "action": "edit", "resource": "app/**", "effect": "ask" },
    { "action": "edit", "resource": "src/**", "effect": "ask" },
    { "action": "edit", "resource": "tests/**", "effect": "ask" },
    { "action": "edit", "resource": "docs/**", "effect": "ask" },
    { "action": "edit", "resource": "seguridad/**", "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/**", "effect": "deny" },
    { "action": "edit", "resource": "**/opencode.json", "effect": "deny" },
    { "action": "edit", "resource": "**/opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": "**/AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "**/.opencode/**", "effect": "deny" },
    { "action": "edit", "resource": "**/composer.json", "effect": "deny" },
    { "action": "edit", "resource": "**/composer.lock", "effect": "deny" },
    { "action": "edit", "resource": "id_rsa*", "effect": "deny" },
    { "action": "edit", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "edit", "resource": "id_ed25519*", "effect": "deny" },
    { "action": "edit", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "**/*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "**/*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "**/*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "**/*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "**/.env", "effect": "deny" },
    { "action": "edit", "resource": "**/*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "**/*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "composer.json", "effect": "deny" },
    { "action": "edit", "resource": "composer.lock", "effect": "deny" },

    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "deny" },

    { "action": "shell", "resource": "opencode --version", "effect": "allow" },
    { "action": "shell", "resource": "opencode debug agents", "effect": "allow" },
    { "action": "shell", "resource": "opencode debug config", "effect": "allow" },
    { "action": "shell", "resource": "opencode mcp list", "effect": "allow" },

    { "action": "shell", "resource": "php --version", "effect": "allow" },
    { "action": "shell", "resource": "php -m", "effect": "allow" },
    { "action": "shell", "resource": "php --ini", "effect": "allow" },
    { "action": "shell", "resource": "composer --version", "effect": "allow" },
    { "action": "shell", "resource": "php seguridad/mecanismos/tests/run.php", "effect": "allow" },

    { "action": "shell", "resource": "git --no-pager --no-optional-locks status", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks status --short", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks status --short --branch", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks diff", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks diff HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks diff --cached", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks diff --check", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks log -1 --oneline", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks show --stat --oneline HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks branch --list", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks tag --list", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks rev-parse HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks rev-parse --show-toplevel", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks ls-files", "effect": "allow" },
    { "action": "shell", "resource": "git --no-pager --no-optional-locks ls-files --others --exclude-standard", "effect": "allow" },

    { "action": "webfetch", "resource": "https://opencode.ai/v2/docs/*", "effect": "allow" },
    { "action": "webfetch", "resource": "https://opencode.ai/v2/llms.txt", "effect": "allow" },
    { "action": "skill", "resource": "opencode", "effect": "allow" }
  ],

  "policies": [
    { "action": "tool.use", "resource": "*", "effect": "deny" },

    { "action": "tool.use", "resource": "read:*", "effect": "allow" },
    { "action": "tool.use", "resource": "glob:*", "effect": "allow" },

    { "action": "tool.use", "resource": "edit:app/**", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:src/**", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:tests/**", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:docs/**", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:seguridad/**", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:opencode.jsonc", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:AGENTS.md", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:.opencode/agents/**", "effect": "allow" },

    { "action": "tool.use", "resource": "webfetch:https://opencode.ai/v2/docs/*", "effect": "allow" },
    { "action": "tool.use", "resource": "webfetch:https://opencode.ai/v2/llms.txt", "effect": "allow" },
    { "action": "tool.use", "resource": "skill:opencode", "effect": "allow" },
    { "action": "tool.use", "resource": "question:*", "effect": "allow" },
    { "action": "tool.use", "resource": "subagent:backend", "effect": "allow" },
    { "action": "tool.use", "resource": "subagent:frontend", "effect": "allow" },
    { "action": "tool.use", "resource": "subagent:revisor", "effect": "allow" },
    { "action": "tool.use", "resource": "subagent:qa", "effect": "allow" },

    { "action": "tool.use", "resource": "shell:opencode --version", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:opencode debug agents", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:opencode debug config", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:opencode mcp list", "effect": "allow" },

    { "action": "tool.use", "resource": "shell:php --version", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:php -m", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:php --ini", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:composer --version", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:php seguridad/mecanismos/tests/run.php", "effect": "allow" },

    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks status", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks status --short", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks status --short --branch", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks diff", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks diff HEAD", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks diff --cached", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks diff --check", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks log -1 --oneline", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks show --stat --oneline HEAD", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks branch --list", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks tag --list", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks rev-parse HEAD", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks rev-parse --show-toplevel", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks ls-files", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:git --no-pager --no-optional-locks ls-files --others --exclude-standard", "effect": "allow" },

    { "action": "integration.use", "resource": "mcp:*", "effect": "deny" }
  ],

  "agents": {
    // El equipo utiliza un único agente principal seleccionable en este proyecto.
    "build": { "disabled": true },
    "plan": { "disabled": true }
  }
}
